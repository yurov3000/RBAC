*=== Доступные команды ===
X  report-users           — Отчёт по пользователям с ролями
E  user-delete            — Удалить пользователя
3  role-search            — Поиск ролей
H  assignment-list        — Список всех назначений
b  assignment-list-user   — Назначения конкретного пользователя
I  save                   — Сохранить данные в файл
T  user-update            — Обновить данные пользователя
T  permissions-check      — Проверить право пользователя
R  assign-role            — Назначить роль пользователю
M  load                   — Загрузить данные из файла
Y  assignment-list-role   — Пользователи с конкретной ролью
A  stats                  — Статистика системы
Y  user-search            — Поиск пользователей по фильтрам
M  role-list              — Вывести список всех ролей
]  user-list              — Вывести список всех пользователей
R  user-create            — Создать нового пользователя
_  user-view              — Просмотр информации о пользователе
7  role-view              — Просмотр роли
7  role-update            — Обновить роль
S  assignment-search      — Поиск назначений по фильтрам
S  revoke-role            — Отозвать роль у пользователя
_  permissions-user       — Все права конкретного пользователя
m  report-roles           — Отчёт по ролям с количеством пользователей
5  role-delete            — Удалить роль
q  report-matrix          — Матрица прав доступа (пользователи × ресурсы)
9  clear                  — Очистить экран
E  role-add-permission    — Добавить право к роли
P  assignment-active      — Только активные назначения
@  role-create            — Создать новую роль
B  help                   — Справка по командам
@  exit                   — Выход из программы
V  assignment-expired     — Истёкшие временные назначения
E  role-remove-permission — Удалить право из роли
D  audit-log              — Просмотр лога аудита
V  assignment-extend      — Продлить временное назначение
